    {
      "parameters": {
        "jsCode": "// Mismo criterio que WF2: el QR lo sirve la app en /api/qr/<slug>.\nconst base = String($env.NEXT_PUBLIC_BASE_URL || 'https://amor.uniongloss.com').replace(/\\/+$/, '');\nconst slug = $json.slug || '';\nconst publicUrl = base + '/s/' + slug;\nconst qrDataUrl = base + '/api/qr/' + slug;\nreturn [{ json: { publicUrl: publicUrl, qrDataUrl: qrDataUrl } }];\n",
        "notes": "El QR lo genera la app en /api/qr/<slug> (H, margin 4). Sin módulos externos en n8n."
      },
      "id": "687d6548-2b37-4540-a887-f3aed931f8f3",
      "name": "Generate QR",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        940,
        260
      ],
      "notes": "node-qrcode, error correction H, margin 4 (PLAN §16)."
    },
    {
      "parameters": {
        "fromEmail": "={{ $env.MAIL_FROM }}",
        "toEmail": "={{ $('Select Order and Page').item.json.buyer_email }}",
        "subject": "=Tu QR de Latido (reenvío)",
        "emailFormat": "html",
        "html": "=<p>¡Hola {{ $('Select Order and Page').item.json.buyer_name || '' }}!</p>\n<p>Este es el link de tu sorpresa:</p>\n<p><a href=\"{{ $json.publicUrl }}\">{{ $json.publicUrl }}</a></p>\n<p><img src=\"{{ $json.qrDataUrl }}\" alt=\"QR de tu sorpresa Latido\" width=\"240\" height=\"240\" /></p>\n<p>— Latido</p>",
        "options": {}
      },
      "id": "c2dfee8f-bdbd-4a9b-a4e8-758f2e22966f",
      "name": "Resend Delivery Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        1180,
        260
      ],
      "credentials": {
        "smtp": {
          "id": "6eBST20ucQSn4CX5",
          "name": "Latido SMTP"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\n\nfunction safeEqual(a, b) {\n  const left = Buffer.from(String(a));\n  const right = Buffer.from(String(b));\n  if (left.length !== right.length) return false;\n  return crypto.timingSafeEqual(left, right);\n}\n\nconst item = $input.first();\nconst json = item.json || {};\nconst headers = json.headers || {};\nconst provided = headers['x-latido-secret'] || '';\nconst expected = $env.LATIDO_ADMIN_SECRET || '';\nconst authorized = expected.length > 0 && safeEqual(provided, expected);\n\n// TODO(latido): constant-time shared-secret check. Replace with the native\n// signature scheme once confirmed against the provider docs.\n// String en vez de booleano: el nodo If de n8n 2.x con validacion estricta\n// rechaza el valor booleano false (\"Wrong type: '' is a string\").\nreturn [{ json: Object.assign({}, json, { authorized: authorized ? 'yes' : 'no' }) }];"
      },
      "id": "084d8702-ac8c-4318-9a97-84bb3add6c75",
      "name": "Verify Admin Secret",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        560
      ],
      "notes": "Shared secret in x-latido-secret vs $env.LATIDO_ADMIN_SECRET."
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "9f6f7431-53fb-447f-9010-483ae7eb25c7",
              "leftValue": "={{ $json.authorized }}",
              "rightValue": "yes",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {},
        "notes": "Comparacion de strings (\"yes\"/\"no\") en vez de booleano estricto: n8n 2.x rechaza false en condiciones boolean."
      },
      "id": "97babac7-c260-41fb-ba8e-94ab65a9c81e",
      "name": "Admin Secret Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        460,
        560
      ],
      "notes": "true = shared secret matches -> continue; false -> 401 and stop."
    },
