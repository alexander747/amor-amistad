      "notes": "POST https://n8n.uniongloss.com/webhook/deliver-qr?code=LAT-XXXXXX. responseNode: 401 for a bad admin secret, 200 otherwise, without waiting for QR/email work."
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT o.id AS order_id, o.code, o.buyer_email, o.buyer_name, p.id AS page_id, p.slug FROM orders o JOIN pages p ON p.order_id = o.id WHERE o.code = ($1::jsonb #>> '{}');",
        "options": {
          "queryReplacement": "={{ JSON.stringify($json.query.code || ($json.body && $json.body.code) || '') }}"
        }
      },
      "id": "790e8cd6-01cb-46bc-ade1-436fc7036063",
      "name": "Select Order and Page",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [
        460,
        320
      ],
      "alwaysOutputData": true,
      "credentials": {
        "postgres": {
          "id": "XwvJlleNNP4iWjFa",
          "name": "Latido Postgres"
        }
      },
      "notes": "Parameterized lookup by order code."
